# виртуальные окружения
.venv/
venv/
__pycache__/
*.pyc

# база данных и данные датчиков
data/
*.sqlite3

# временные файлы
*.tmp
~$*

# сборка PlatformIO
.pio/

# временные записи проверок «Аниме-сонглесса»: их создаёт songless_test_data.py
front/games/animesongless/audio/sl-test-*.wav

# скачанное с YouTube для «Аниме-сонглесса»: рабочий каталог _fetch_songless_audio.py,
# после нарезки в базу его можно удалить (записи защищены авторским правом и в
# репозиторий не попадают)
_songless_audio/

# опубликованный на сайте файл подключения: в нём ключ панели, поэтому в
# репозиторий он попадать не должен (на хостинг его кладёт _publish_address.py)
front/games/api-address.json

# редакторы
.vscode/
.idea/

# куки YouTube: это секреты, в публичный репозиторий они попадать не должны
_at_cookies*.txt

# скачанные записи опенингов (авторские права, десятки мегабайт): в базу они
# попадают фрагментами через songs.py, а в репозитории им не место
_audio_db/
_songless_audio_new/
authorized_audio/
